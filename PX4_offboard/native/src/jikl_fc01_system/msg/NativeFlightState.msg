# 原生Runtime/Core在真实发布边界之后产生的运行期证据，只供任务观察，不授予解锁/发布权。
# stamp为本快照ROS观察时刻；local_sample_stamp_us等保留PX4同步源时刻，重复快照不能续鲜测量。
# native/local_receive_monotonic_ns仅在同一香橙派主机比较。source_id绑定boot+PID+进程启动会话。
# task_epoch在原生安全重新准备后推进；旧进程/旧任务READY或到高状态不可复用。
# reference_z_ned/z_ned向下正m；relative_height_m=z0-z向上正m；vz_ned向下正m/s。
# target_height_m是任务最终相对地面目标，不是平滑轨迹点；无效测量为NaN并清有效布尔。
uint16 schema_version 1
uint64 sequence
builtin_interfaces/Time stamp
string source_id
string boot_id
string profile
string phase
string reason
uint64 controller_pid
uint64 task_epoch
uint64 native_monotonic_ns
bool feedback_current
bool publication_current
bool ready_wait_arm
bool armed
bool offboard
bool landed
bool at_rest
bool kill
bool operator_takeover
bool failsafe
bool rc_navigation_enabled
bool rc_manual_arm_proven
bool ground_reference_valid
bool ground_reference_qualified
bool liftoff_confirmed
bool target_height_settled
bool navigation_allowed
uint8 rc_mode_slot
uint8 rc_navigation_mode_slot
uint8 z_reset_counter
uint8 vz_reset_counter
uint8 quat_reset_counter
uint64 prestream_commits
uint64 status_stamp_us
uint64 land_stamp_us
uint64 local_stamp_us
uint64 local_sample_stamp_us
uint64 attitude_stamp_us
uint64 attitude_sample_stamp_us
uint64 local_receive_monotonic_ns
float64 reference_z_ned
float64 z_ned
float64 vz_ned
float64 relative_height_m
float64 target_height_m
float64 height_tolerance_m
float64 speed_tolerance_mps
float64 settle_seconds
