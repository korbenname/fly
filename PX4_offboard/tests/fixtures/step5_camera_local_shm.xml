<?xml version="1.0" encoding="UTF-8" ?>
<!-- 仅隔离的raw Image回归使用；不安装到飞控DDS环境、不改MicroXRCEAgent通信。
     640x480 bgr8载荷921600字节大于FastDDS默认约512KiB共享段。
     16MiB为本机图像测试的有限容量，队列仍keep-last1，不靠增加TTL掩盖丢帧。 -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>step5_shm_images</transport_id>
      <type>SHM</type>
      <segment_size>16777216</segment_size>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>step5_local_udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="step5_local_images" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>step5_shm_images</transport_id>
        <transport_id>step5_local_udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
